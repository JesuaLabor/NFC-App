{
  "expo": {
    "name": "NFC Programmer",
    "slug": "nfc-programmer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "nfcprogrammer",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nfcprogrammer.app",
      "infoPlist": {
        "NFCReaderUsageDescription": "NFC Programmer uses NFC to read and write data to NFC tags.",
        "com.apple.developer.nfc.readersession.formats": [
          "NDEF",
          "TAG"
        ],
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.developer.nfc.readersession.formats": [
          "NDEF",
          "TAG"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A0E1A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.nfcprogrammer.app",
      "permissions": [
        "android.permission.NFC"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "root": "./app"
        }
      ],
      [
        "react-native-nfc-manager",
        {
          "nfcPermission": "NFC Programmer uses NFC to read and write data to NFC tags."
        }
      ]
    ],
    "extra": {
      "router": {
        "root": "./app"
      },
      "eas": {
        "projectId": "7907b55d-90f2-42fd-b32c-6348fcedd554"
      }
    }
  }
}
